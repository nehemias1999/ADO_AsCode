# ---------------------------------------------------------------------------
# Template for members.env.
#
# Rename this file to members.env (dropping .example) to create your local
# membership file. The renamed file is excluded from version control, so the
# list of people never reaches the repository history.
#
# One variable per application, named by `membersEnv` in applications.json.
# Separate entries with a semicolon, a comma or a newline. Every address must
# already have access to the organization: this automation adds people to a
# Team, it does not license them.
# ---------------------------------------------------------------------------

APP_ALPHA_MEMBERS=first.owner@contoso.com;second.owner@contoso.com

APP_BETA_MEMBERS=
