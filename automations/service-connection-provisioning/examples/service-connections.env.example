# ---------------------------------------------------------------------------
# Credential variables for service-connection-provisioning.
#
# Names only. Every value in this file is empty, and that is the point: the
# repository declares which variables a connection needs, never what they hold.
#
# Copy the lines you need into your local .env, or into the secret variables of
# the pipeline that runs the automation. Never fill them in here.
#
# `Invoke-ServiceConnectionProvisioning.ps1 -Command validate` prints exactly
# this list for your own declaration, so a credential handover is a checklist
# rather than a guess.
#
# A connection with no credential available is created with the placeholder
# PENDING_OWNER_CONFIGURATION, and whoever holds the credential completes it in
# the portal. No later run overwrites what they set.
# ---------------------------------------------------------------------------

# --- APP_ALPHA -------------------------------------------------------------
SFTP_APP_ALPHA_DEV_HOST=
SFTP_APP_ALPHA_DEV_USERNAME=
SFTP_APP_ALPHA_DEV_PASSWORD=
SFTP_APP_ALPHA_DEV_PRIVATE_KEY=

SFTP_APP_ALPHA_QA_HOST=
SFTP_APP_ALPHA_QA_USERNAME=
SFTP_APP_ALPHA_QA_PASSWORD=
SFTP_APP_ALPHA_QA_PRIVATE_KEY=

SFTP_APP_ALPHA_PROD_HOST=
SFTP_APP_ALPHA_PROD_USERNAME=
SFTP_APP_ALPHA_PROD_PASSWORD=
SFTP_APP_ALPHA_PROD_PRIVATE_KEY=

# --- APP_BETA --------------------------------------------------------------
SFTP_APP_BETA_DEV_HOST=
SFTP_APP_BETA_DEV_USERNAME=
SFTP_APP_BETA_DEV_PASSWORD=
SFTP_APP_BETA_DEV_PRIVATE_KEY=

SFTP_APP_BETA_QA_HOST=
SFTP_APP_BETA_QA_USERNAME=
SFTP_APP_BETA_QA_PASSWORD=
SFTP_APP_BETA_QA_PRIVATE_KEY=
