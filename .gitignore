# Local environment files. Never commit a real secret value.
.env
.env.*
!.env.example

# Workstation scratch space: drafts, exports, credential files handed over out of band.
.local/

# Reproducible run outputs (plans, reports, receipts, logs).
artifacts/

# Active configuration created by renaming a versioned template.
automations/*/config/applications.json
automations/*/config/members.env
automations/*/config/scope.json
automations/*/config/variable-groups.csv
automations/*/config/service-connections.json

# Misc
*.log
*.tmp
*.bak
