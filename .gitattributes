* text=auto

# PowerShell is executed on Windows agents; keep CRLF in the working tree.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# Pipeline definitions and configuration are consumed by cross-platform tooling.
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
