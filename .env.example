# ---------------------------------------------------------------------------
# Template for the local .env file.
#
# Copy this file to .env (scripts/bootstrap.ps1 does it for you) and fill in
# the values on your workstation only. .env is ignored by Git and must never
# be committed, pasted into a ticket, or shared over chat.
#
# Rule enforced across this repository: configuration files declare the NAME
# of an environment variable, never its value. Values live here, or in the
# secret store of the pipeline that runs the automation.
# ---------------------------------------------------------------------------

# --- Azure DevOps connection (required by every automation) ----------------
# Organization URL, without a trailing slash.
ADO_ORG_URL=https://dev.azure.com/contoso
# Team project that holds the Teams, Boards, Variable Groups and connections.
ADO_PROJECT=Platform
# Personal Access Token. See docs/guides/getting-started.md for the minimum
# scopes and keep the shortest expiry that covers your change window.
ADO_PAT=

# --- Team membership (team-provisioning) -----------------------------------
# One variable per application. The value is a semicolon-separated list of
# user principal names that already exist in the organization.
APP_ALPHA_MEMBERS=
APP_BETA_MEMBERS=

# --- Variable Group values (variable-group-configuration) ------------------
# Non-secret defaults may be declared here so the same value is not retyped
# per environment. A key left empty stays at PENDING_OWNER_CONFIGURATION and
# is not written to Azure DevOps.
APP_SERVER_HOST_DEV=
APP_SERVER_HOST_QA=
APP_SERVER_HOST_PROD=

# --- Service Connection credentials (service-connection-provisioning) -----
# Secret values for SSH/SFTP endpoints. Leave empty to create the connection
# with the PENDING_OWNER_CONFIGURATION placeholder and let the platform owner
# complete it in the portal.
SFTP_APP_ALPHA_DEV_HOST=
SFTP_APP_ALPHA_DEV_USERNAME=
SFTP_APP_ALPHA_DEV_PASSWORD=
SFTP_APP_ALPHA_DEV_PRIVATE_KEY=
